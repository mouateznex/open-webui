# ===========================================================================
# Rocket.Chat integration — environment template
# ===========================================================================
# Copy to `.env` in the directory you run `docker compose` from, then replace
# every change-me value and every example.com domain. After editing, validate:
#
#   ./deploy/rocketchat/scripts/validate-env.sh        (Linux/macOS)
#   ./deploy/rocketchat/scripts/validate-env.ps1       (Windows PowerShell)
#
# This file is runnable as-is once you replace secrets + domains. No hidden
# variables live elsewhere.
# ===========================================================================

# ---------------------------------------------------------------------------
# URLs — keep these five concepts distinct (see README "URL topology")
# ---------------------------------------------------------------------------
# Browser-facing Open WebUI URL (what users type / OIDC issuer).
WEBUI_URL=https://app.example.com
# URL Rocket.Chat uses to reach Open WebUI's OAuth endpoints. MUST resolve
# identically from the user's browser AND from inside the rocketchat container.
WEBUI_OAUTH_URL=https://app.example.com
# Browser-facing Rocket.Chat URL — also set as Rocket.Chat's ROOT_URL.
ROCKETCHAT_PUBLIC_URL=https://chat.example.com
# Container-to-container URL the Open WebUI backend uses for RC REST + DDP calls.
ROCKETCHAT_INTERNAL_URL=http://rocketchat:3000
# Browser-facing URL Open WebUI uses to build Rocket.Chat deep-links.
# Normally identical to ROCKETCHAT_PUBLIC_URL.
ROCKETCHAT_BASE_URL=https://chat.example.com

# ---------------------------------------------------------------------------
# OAuth 2.0 / OIDC — Open WebUI is the identity provider
# ---------------------------------------------------------------------------
OAUTH_SERVER_CLIENT_ID=rocketchat
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
OAUTH_SERVER_CLIENT_SECRET=change-me-generate-random
# Rocket.Chat's OAuth callback. Provider name "OpenWebUI" => /_oauth/openwebui.
OAUTH_SERVER_REDIRECT_URIS=https://chat.example.com/_oauth/openwebui

# ---------------------------------------------------------------------------
# Rocket.Chat service account (admin bot — NOT a real user)
# ---------------------------------------------------------------------------
ROCKETCHAT_ADMIN_USER=rc_service_bot
# Generate: python -c "import secrets; print(secrets.token_urlsafe(24))"
ROCKETCHAT_ADMIN_PASSWORD=change-me-generate-random
ROCKETCHAT_ADMIN_EMAIL=rc-service@example.com

# ---------------------------------------------------------------------------
# Open WebUI core secret (required by the base stack regardless of RC)
# ---------------------------------------------------------------------------
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
WEBUI_SECRET_KEY=change-me-generate-random

# ---------------------------------------------------------------------------
# Image tags — PIN these. Never rely on :latest for a reproducible deployment.
# ---------------------------------------------------------------------------
ROCKETCHAT_TAG=7.4.1
MONGO_TAG=7.0

# ---------------------------------------------------------------------------
# Feature flag
# ---------------------------------------------------------------------------
# true = force-enable, false = force-disable, unset = auto-detect from creds.
ROCKETCHAT_ENABLED=true

# ---------------------------------------------------------------------------
# Optional features (leave blank to disable)
# ---------------------------------------------------------------------------
# AI slash command (/ask) — shared secret for RC outgoing webhook.
ROCKETCHAT_SLASH_TOKEN=
ROCKETCHAT_SLASH_MODEL=
# Jitsi video calls — any Jitsi-compatible server URL.
JITSI_URL=
# Matrix federation — domain RC advertises as its Matrix homeserver.
MATRIX_HOMESERVER_DOMAIN=

# ---------------------------------------------------------------------------
# Host port mappings (optional — defaults shown)
# ---------------------------------------------------------------------------
OPEN_WEBUI_PORT=3000
ROCKETCHAT_PORT=3100
